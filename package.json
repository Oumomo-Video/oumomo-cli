{
  "name": "@oumomo/cli",
  "version": "0.1.0",
  "description": "Public command-line client for Oumomo APIs.",
  "type": "module",
  "bin": { "oumomo": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check:public": "node scripts/check-public.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
