{
  "name": "oumomo-agent",
  "version": "0.1.0",
  "private": false,
  "description": "Thin CLI client for Oumomo published skills. Handles OAuth device login, image upload, and lets the Codex `oumomo-video-replica` skill call the allowlisted tools through Oumomo's direct-tool API.",
  "type": "module",
  "bin": {
    "oumomo-agent": "dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-bin-executable.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare": "npm run build",
    "test:cli": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build && npm test",
    "verify:size": "node scripts/verify-pack-size.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
